<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests only. Nothing here needs a live tenant, a live vault or a live SQL
    instance: Key Vault and SQL are represented by fakes, and certificates are
    created in memory.
  -->

  <PropertyGroup>
    <TargetFramework>$(ConnectorTargetFramework)</TargetFramework>
    <RootNamespace>SqlTicketsConnector.Tests</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NETSDK1206;CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SqlTicketsConnector\SqlTicketsConnector.csproj" />

    <!--
      The push engine and the two connectors that run on it. Their schemas and
      configuration validation carry the most expensive failure in the system -
      a registered schema cannot be corrected, only deleted with every item in
      it - so they are tested here rather than read carefully. Referencing an
      Exe project is what makes the public types in it reachable; nothing
      internal is exposed.
    -->
    <ProjectReference Include="..\..\src\PushCore\PushCore.csproj" />
    <ProjectReference Include="..\..\src\PushCore.Sql\PushCore.Sql.csproj" />
    <ProjectReference Include="..\..\src\SqlGraphPush\SqlGraphPush.csproj" />
    <ProjectReference Include="..\..\src\SqlHierarchyPush\SqlHierarchyPush.csproj" />
    <ProjectReference Include="..\..\src\Connector.Security\Connector.Security.csproj" />

    <!--
      The dashboard, for ReaderPolicy alone. Referenced rather than copied
      because the alternative is a test that rebuilds the authorization rule
      itself and then agrees with its own copy - which passes whatever the
      application does, and is the shape of test this repository has already
      been caught writing once.
    -->
    <ProjectReference Include="..\..\src\ConnectorState.Dashboard\ConnectorState.Dashboard.csproj" />

    <!--
      The Cloudera CDP connector and the two libraries behind it. Referenced for
      the same reason the SQL push tools are: the routing refusals, the ACL
      derivation and the watermark comparison are the most expensive things here
      to get wrong, and a test project that could not see them would be testing
      the easy half.
    -->
    <ProjectReference Include="..\..\src\CdpGraphPush\CdpGraphPush.csproj" />
    <ProjectReference Include="..\..\src\CdpConnector.Source\CdpConnector.Source.csproj" />
    <ProjectReference Include="..\..\src\CdpConnector.Extraction\CdpConnector.Extraction.csproj" />
    <ProjectReference Include="..\..\src\PushCore.Db\PushCore.Db.csproj" />
    <ProjectReference Include="..\..\src\OracleGraphPush\OracleGraphPush.csproj" />
    <ProjectReference Include="..\..\src\TeradataGraphPush\TeradataGraphPush.csproj" />
    <ProjectReference Include="..\..\src\MongoGraphPush\MongoGraphPush.csproj" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\build\SecretHygiene.targets" />

</Project>
