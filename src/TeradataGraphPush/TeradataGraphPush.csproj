<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(ConnectorTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TeradataGraphPush</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PushCore\PushCore.csproj" />
    <ProjectReference Include="..\PushCore.State\PushCore.State.csproj" />
    <ProjectReference Include="..\PushCore.Db\PushCore.Db.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one place Teradata's driver is referenced in this solution. -->
    <PackageReference Include="Teradata.Client.Provider" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\build\SecretHygiene.targets" />

</Project>
