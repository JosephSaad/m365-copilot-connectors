{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "CrawlState": {
    "Server": "SQLPROD01",
    "Database": "ConnectorState",
    "Encrypt": true,
    "TrustServerCertificate": false,
    "ConnectTimeoutSeconds": 15,
    "CommandTimeoutSeconds": 60,
    "DefaultPageSize": 50,
    "SummaryWindowHours": 24,
    "ApplicationName": "ConnectorState.Dashboard"
  }
}
