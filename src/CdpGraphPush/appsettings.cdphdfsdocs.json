{
  // ------------------------------------------------------------------------
  // CdpGraphPush --connector cdphdfsdocs
  // Documents held in HDFS on a Cloudera CDP Private Cloud Base 7.1.9 cluster.
  //
  // Nothing in this file is a secret and nothing in it may become one. The
  // cluster is reached with Kerberos as the account this service runs as - a
  // gMSA for preference - so there is no password, no keytab path and no
  // connection string here to hold one. Graph and Key Vault are reached with
  // the certificate named below, whose private key stays in the machine store.
  // ------------------------------------------------------------------------

  "Environment": "Production",

  "Auth": {
    "Mode": "Certificate",
    "TenantId": "REPLACE-WITH-TENANT-GUID",
    "ClientId": "REPLACE-WITH-CLIENT-GUID",
    "CertificateStoreLocation": "LocalMachine",
    "CertificateThumbprints": [ "REPLACE-WITH-CURRENT-THUMBPRINT" ],
    "CertificateSubject": "",
    "ExpiryWarningDays": 30,
    "ClientSecretCredentialTarget": ""
  },

  // No vault is needed: this connector resolves no secret at all. The section
  // stays so that a deployment which later adds one has somewhere to put it.
  "KeyVault": {
    "Uri": "",
    "SecretCacheTtlMinutes": 60,
    "Secrets": {}
  },

  // Only the two source-agnostic knobs the engine reads. There is no SQL
  // Server here; the section is named for its oldest consumer rather than for
  // this one, and the remaining keys are deliberately absent.
  "DataSource": {
    "MaxContentBytes": 3670016
  },

  // Empty on purpose. Every file carries the grants HDFS and Ranger give it,
  // so a connection-wide grant would be wrong for almost every item. A file
  // whose groups cannot be resolved is skipped, never granted this list.
  "Acl": {
    "GrantGroupObjectIds": [ "REPLACE-WITH-ENTRA-GROUP-OBJECT-ID" ]
  },

  "Graph": {
    "ConnectionId": "cdphdfsdocs",
    "ConnectionName": "Cloudera HDFS documents",
    "Description": "Documents held in HDFS on the Cloudera CDP cluster",
    "SchemaReadyTimeoutMinutes": 30
  },

  // A filesystem has roots rather than a view. Left empty deliberately.
  "Source": {
    "ItemView": "",
    "MaxItems": 0
  },

  "Settings": {
    // HttpFS in preference to WebHDFS: WebHDFS redirects a read to the DataNode
    // holding the block, so it needs this host to reach every DataNode, while
    // HttpFS is one gateway. Both answer on /webhdfs/v1.
    "HdfsBaseUrl": "https://httpfs01.corp.example:14000/webhdfs/v1",

    // Semicolon separated, absolute, and no default: crawling / is not a scope
    // decision anybody made.
    "HdfsRoots": "/data/contracts;/data/policies",

    // Empty means every format this build can extract. Naming them is the
    // safer habit: it makes "what is in the index" a decision rather than a
    // consequence of which libraries were compiled in.
    "IncludeExtensions": "txt;md;csv;json;xml;html;docx;xlsx;pptx",

    // Above this a file is not read at all - its metadata is still indexed,
    // with extractStatus saying why there is no body. 256 MB.
    "MaxRawFileBytes": "268435456",

    // Subtracted from the stored watermark on resume, to absorb clock skew
    // between this host and the NameNode.
    "ScanSlackSeconds": "900",

    // Ranger decides what may be indexed at all. A row filter or a column mask
    // means the data is queried live instead, and an unreachable Ranger stops
    // the run rather than defaulting to "index it".
    "RangerBaseUrl": "https://ranger01.corp.example:6182",
    "RangerHdfsService": "cm_hdfs",

    // Cluster group name to Entra group object ID, semicolon separated. This
    // is the reviewable form: somebody wrote down what each cluster group means
    // in this tenant, and changing that is a change to a file under review.
    "EntraGroupMap": "hadoop-contracts-read=REPLACE-WITH-ENTRA-GROUP-OBJECT-ID;hadoop-policies-read=REPLACE-WITH-ENTRA-GROUP-OBJECT-ID",

    // Set true only after granting GroupMember.Read.All, which nothing else
    // here uses. It resolves unmapped cluster groups by looking them up in
    // Entra by onPremisesSamAccountName.
    "ResolveGroupsFromDirectory": "false",

    // How long one of those lookups may be reused, in minutes, when
    // Settings:StateConnectionString gives this connector a crawl state
    // database. Only a lookup is cached - never an EntraGroupMap entry, which is
    // read first so an edit to the line above takes effect on the very next run.
    //
    // 720 is what crawl.Connection.PrincipalTtlMinutes defaults to, and the two
    // are meant to move together: uspCachePrincipal in sql/33 clamps only a
    // NEGATIVE answer, to PrincipalNegativeTtlMinutes, so for a group that
    // resolved it is the number sent from here that gets stored. Delete the key
    // to take the built-in 720.
    "PrincipalCacheTtlMinutes": "720",

    // What "readable by everyone on the cluster" means in this tenant. Empty
    // means the other-read bit grants nothing, which is the safe default:
    // everyone on the cluster and everyone in the tenant are different sets of
    // people.
    "OtherReadableGroupId": "",

    "CheckpointDirectory": "state",

    // Every seventh run re-reads everything. This is the ONLY thing that
    // re-derives item ACLs after a permission change at the source, because a
    // permission change does not alter a file's modification time - so at a
    // daily schedule this is a documented seven-day upper bound on ACL
    // staleness, and it belongs in the deployment's risk record. It also
    // catches files moved into scope carrying older timestamps.
    "FullRecrawlEveryRuns": "7",

    "MaxItemsPerRun": "0",

    // A preflight above this fails startup with the number in the message,
    // rather than a connection discovering its own ceiling mid-crawl.
    "ItemBudget": "2000000",

    // Past this percentage of examined files failing to read or extract, the
    // run stops instead of reporting a successful crawl that was mostly skips.
    "MaxErrorRatePercent": "5"
  }
}
