{
  // ------------------------------------------------------------------------
  // CdpGraphPush --connector cdphivecontracts
  // One Hive table on a Cloudera CDP Private Cloud Base 7.1.9 cluster.
  //
  // The ODBC connection string is COMPOSED from the keys below rather than
  // pasted in as one. That is deliberate: a pasted connection string is where
  // a UID and a PWD end up, and this connector authenticates with Kerberos
  // over SSPI as the account the service runs as. There is no credential in
  // this file, and Settings:HiveExtraOptions is inspected at startup so one
  // cannot be smuggled in through it.
  // ------------------------------------------------------------------------

  "Environment": "Production",

  "Auth": {
    "Mode": "Certificate",
    "TenantId": "REPLACE-WITH-TENANT-GUID",
    "ClientId": "REPLACE-WITH-CLIENT-GUID",
    "CertificateStoreLocation": "LocalMachine",
    "CertificateThumbprints": [ "REPLACE-WITH-CURRENT-THUMBPRINT" ],
    "CertificateSubject": "",
    "ExpiryWarningDays": 30,
    "ClientSecretCredentialTarget": ""
  },

  "KeyVault": {
    "Uri": "",
    "SecretCacheTtlMinutes": 60,
    "Secrets": {}
  },

  // MaxContentBytes is the engine's truncation ceiling; CommandTimeoutSeconds
  // is the query timeout the ODBC reader uses. No SQL Server is involved.
  "DataSource": {
    "MaxContentBytes": 3670016,
    "CommandTimeoutSeconds": 600
  },

  // Empty on purpose: the grants come from Ranger's policies on the table, so
  // a policy change reaches the index on the next run without anybody editing
  // this file.
  "Acl": {
    "GrantGroupObjectIds": []
  },

  "Graph": {
    "ConnectionId": "cdphivecontracts",
    "ConnectionName": "Cloudera Hive contracts",
    "Description": "Contract records held in Hive on the Cloudera CDP cluster",
    "SchemaReadyTimeoutMinutes": 30
  },

  // database.table. Concatenated into the query, so it is validated as an
  // identifier before use - a table cannot be a parameter.
  "Source": {
    "ItemView": "contracts.contract",
    "MaxItems": 0
  },

  "Settings": {
    "HiveHost": "hs2-01.corp.example",

    // 10001 is HiveServer2 over HTTP; 10000 is the SASL transport; 21050 is
    // Impala. Kerberos does not support the binary transport at all.
    "HivePort": "10001",
    "HiveDriver": "Cloudera ODBC Driver for Apache Hive",
    "HiveTransport": "http",
    "HiveHttpPath": "cliservice",
    "HiveUseSsl": "true",
    "HiveRealm": "CORP.EXAMPLE",
    "HiveServiceName": "hive",

    // Inspected at startup: a credential keyword or a TLS downgrade here is a
    // configuration error, not a silently accepted override.
    "HiveExtraOptions": "",

    // Sspi means the driver authenticates from this service's Windows logon
    // session and nothing holds a credential. MitKeytab is the fallback for a
    // cluster whose realm has no trust to Active Directory, and it puts a
    // keytab on disk - a secret at rest - so it is chosen deliberately.
    "KerberosMode": "Sspi",

    // Incremental reads need both: the timestamp orders the rows, the key
    // breaks ties so a run interrupted inside one second's worth of rows
    // resumes exactly. Leave both empty to re-read the whole table every run.
    "HiveWatermarkColumn": "last_modified_ts",
    "HiveKeyColumn": "contract_ref",

    "RangerBaseUrl": "https://ranger01.corp.example:6182",

    // One Ranger service definition governs Hive and Impala, so this covers
    // whichever engine the driver connects to.
    "RangerSqlService": "cm_hive",

    "EntraGroupMap": "hadoop-contracts-read=REPLACE-WITH-ENTRA-GROUP-OBJECT-ID",
    "ResolveGroupsFromDirectory": "false",

    "CheckpointDirectory": "state",
    "FullRecrawlEveryRuns": "7",
    "MaxItemsPerRun": "0",
    "ItemBudget": "2000000",
    "MaxErrorRatePercent": "5"
  }
}
