{
  "Environment": "Production",

  "Connector": {
    "Id": "9e5e2b95-e7ab-4266-98c7-4f7868d377bf",
    "Port": 30303,
    "UseTls": true,
    "TlsCertificateThumbprint": ""
  },

  "Auth": {
    "Mode": "Certificate",
    "TenantId": "REPLACE-WITH-TENANT-GUID",
    "ClientId": "REPLACE-WITH-CLIENT-GUID",
    "CertificateStoreLocation": "LocalMachine",
    "CertificateThumbprints": [ "REPLACE-WITH-CURRENT-THUMBPRINT" ],
    "CertificateSubject": "CN=sqltickets.contoso.local",
    "ExpiryWarningDays": 30,
    "ClientSecretCredentialTarget": ""
  },

  "KeyVault": {
    "Uri": "https://kv-connectors-prod.vault.azure.net/",
    "SecretCacheTtlMinutes": 60,
    "Secrets": {
      "SqlPassword": "sql-tickets-reader-password"
    }
  },

  "DataSource": {
    "Server": "sql01.contoso.local",
    "Database": "Ops",
    "SqlAuthMode": "WindowsIntegrated",
    "MaxContentBytes": 3670016,
    "ItemUrlTemplate": "https://tickets.contoso.com/ticket/{0}",
    "SoftDeleteEnabled": true,
    "SqlUserId": "",
    "ExtraConnectionOptions": "",
    "ConnectRetryCount": 3,
    "ConnectRetryIntervalSeconds": 10,
    "ConnectTimeoutSeconds": 30
  },

  "Acl": {
    "GrantGroupObjectIds": [ "REPLACE-WITH-ENTRA-GROUP-OBJECT-ID" ]
  },

  "Logging": {
    "Directory": "C:\\Connectors\\SqlTickets\\Logs",
    "MinimumLevel": "Information",
    "EventLogEnabled": true,
    "EventLogSource": "SqlTicketsConnector",
    "FileSizeLimitBytes": 10485760,
    "RetainedFileCountLimit": 30,
    "Otlp": {
      "Enabled": false,
      "Endpoint": ""
    }
  }
}
