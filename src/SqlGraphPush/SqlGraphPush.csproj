<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(ConnectorTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SqlGraphPush</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The engine, and through it SqlTicketsConnector.Security and the Graph
      SDK. Package versions and their advisory pins live in SqlPushCore so
      there is one place to change them and the offline restore graph
      cannot drift between the push tools.
    -->
    <ProjectReference Include="..\SqlPushCore\SqlPushCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\build\SecretHygiene.targets" />

</Project>
