<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared security primitives for both the agent-hosted connector and the
    direct-push console app: secret resolution, certificate resolution,
    TokenCredential construction and SQL connection construction.

    This project deliberately references neither the Microsoft Graph SDK nor the
    connector gRPC contracts. The agent-hosted connector must never gain a Graph
    dependency, and keeping the contracts out means the security code can be
    reviewed and unit tested without protobuf codegen.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SqlTicketsConnector.Security</RootNamespace>
    <AssemblyName>SqlTicketsConnector.Security</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Serilog" Version="4.4.0" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\build\SecretHygiene.targets" />

</Project>
