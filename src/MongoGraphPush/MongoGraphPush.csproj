<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(ConnectorTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MongoGraphPush</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      PushCore.Db is deliberately absent. MongoDB is not relational: there is no
      query-and-row-mapping shape to slot into, so this connector implements
      IPushSource directly - Path B in ADDING-A-PUSH-CONNECTOR.md. It still sits
      on the same engine, and inherits $batch, throttling, change detection, the
      delete sweep, checkpointing and redaction unchanged.
    -->
    <ProjectReference Include="..\PushCore\PushCore.csproj" />
    <ProjectReference Include="..\PushCore.State\PushCore.State.csproj" />
    <ProjectReference Include="..\Connector.Security\Connector.Security.csproj" />

    <!--
      Text extraction, for GridFS buckets. NOTE THE NAME: this project is called
      CdpConnector.Extraction and has nothing CDP about it - it reads PDF,
      OpenXML and plain text from a stream. Referencing it here makes it a
      SHARED component with a technology prefix, which is the naming this
      repository otherwise avoids (PushCore, Connector.Security). It should be
      renamed Connector.Extraction; that is a mechanical change across the
      solution, the tests and the harness, and it is deliberately not bundled
      into the change that first needed it.
    -->
    <ProjectReference Include="..\CdpConnector.Extraction\CdpConnector.Extraction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\build\SecretHygiene.targets" />

</Project>
