<?xml version="1.0" encoding="utf-8"?>
<!--
  A NuGet configuration for a build machine with no route to api.nuget.org.

  Copy it to the solution root as NuGet.config and set the path below to the
  folder staged by build\Get-OfflinePackages.ps1:

      copy build\NuGet.offline.config NuGet.config

  <clear /> is the load-bearing line. Without it this file ADDS a source to the
  ones inherited from %APPDATA%\NuGet\NuGet.Config and the machine-wide
  configuration under %ProgramFiles(x86)%\NuGet\Config, nuget.org among them, and
  every restore still reaches for the network first. That inheritance is why a
  command line restore can succeed against a staged folder while Visual Studio
  reports NU1301 seconds later: a source given as a command line argument
  applies to that one command, this file applies to the whole tree, and Visual
  Studio reads only the second kind.

  It is not committed as NuGet.config on purpose. A repository that clears its
  sources cannot restore from nuget.org at all, which would break every online
  build, CI included.
-->
<configuration>

  <packageSources>
    <clear />
    <add key="offline" value="C:\offline-packages" />
  </packageSources>

  <!--
    Belt and braces. If some other configuration puts nuget.org back — a user
    profile written by an installer, a machine policy — it stays switched off
    rather than silently becoming the source a restore prefers.
  -->
  <disabledPackageSources>
    <add key="nuget.org" value="true" />
  </disabledPackageSources>

</configuration>
