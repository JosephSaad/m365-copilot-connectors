<Project>

  <!--
    Build-time secret hygiene gate.

    Fails the build when an appsettings.json in the project carries a key that
    looks like a credential (password | secret | pwd | apikey | connectionstring)
    with a non-empty scalar value. Only names of vault secrets are allowed, and
    only under the documented KeyVault:Secrets path.

    Implemented as an inline task with no external dependencies so it runs on a
    developer workstation and on a build agent identically, and so a reviewer can
    read the whole control in one file.

    Skip for a single build with -p:SkipAppSettingsSecretScan=true. That switch
    is deliberately noisy in build logs.
  -->

  <PropertyGroup>
    <SkipAppSettingsSecretScan Condition="'$(SkipAppSettingsSecretScan)' == ''">false</SkipAppSettingsSecretScan>
    <!--
      Configuration paths whose values are references (names of vault secrets),
      not secrets. Semicolon separated, matched case-insensitively as a prefix.
    -->
    <AppSettingsSecretScanAllowedPaths Condition="'$(AppSettingsSecretScanAllowedPaths)' == ''">KeyVault:Secrets:;KeyVault:SecretCacheTtlMinutes</AppSettingsSecretScanAllowedPaths>
  </PropertyGroup>

  <UsingTask TaskName="ScanAppSettingsForSecrets"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <AllowedPathPrefixes ParameterType="System.String" Required="false" />
      <Findings ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        var pattern = new Regex(@"password|secret|pwd|apikey|connectionstring", RegexOptions.IgnoreCase);
        var allowed = new List<string>();
        foreach (var prefix in (AllowedPathPrefixes ?? string.Empty).Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries))
        {
            allowed.Add(prefix.Trim());
        }

        var found = new List<string>();

        foreach (var file in Files)
        {
            var path = file.GetMetadata("FullPath");
            if (!File.Exists(path))
            {
                continue;
            }

            var text = File.ReadAllText(path);

            // Walk the document tracking the key path, so "KeyVault:Secrets:SqlPassword"
            // can be allowed while a bare "Password" anywhere else is not.
            var stack = new List<string>();
            var tokens = Regex.Matches(text, "\"(?:\\\\.|[^\"\\\\])*\"|[{}\\[\\]:,]|[^\\s{}\\[\\]:,\"]+");
            string pendingKey = null;
            bool expectValue = false;

            foreach (Match token in tokens)
            {
                var value = token.Value;

                if (value == "{" || value == "[")
                {
                    // The root object and array elements contribute no path segment.
                    stack.Add(pendingKey ?? string.Empty);
                    pendingKey = null;
                    expectValue = false;
                    continue;
                }

                if (value == "}" || value == "]")
                {
                    if (stack.Count > 0)
                    {
                        stack.RemoveAt(stack.Count - 1);
                    }

                    pendingKey = null;
                    expectValue = false;
                    continue;
                }

                if (value == ":")
                {
                    expectValue = true;
                    continue;
                }

                if (value == ",")
                {
                    pendingKey = null;
                    expectValue = false;
                    continue;
                }

                if (!expectValue)
                {
                    pendingKey = value.StartsWith("\"") ? value.Trim('"') : value;
                    continue;
                }

                // This token is a scalar value for pendingKey.
                var literal = value.StartsWith("\"") ? value.Substring(1, value.Length - 2) : value;
                expectValue = false;

                if (pendingKey == null || !pattern.IsMatch(pendingKey))
                {
                    pendingKey = null;
                    continue;
                }

                if (literal.Trim().Length == 0 || literal == "null")
                {
                    pendingKey = null;
                    continue;
                }

                var segments = new List<string>();
                foreach (var segment in stack)
                {
                    if (segment.Length > 0)
                    {
                        segments.Add(segment);
                    }
                }

                segments.Add(pendingKey);
                var fullPath = string.Join(":", segments.ToArray());

                var isAllowed = false;
                foreach (var prefix in allowed)
                {
                    if (fullPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                    {
                        isAllowed = true;
                        break;
                    }
                }

                if (!isAllowed)
                {
                    found.Add(path + ": '" + fullPath + "' has a non-empty value and its name matches " +
                              "password|secret|pwd|apikey|connectionstring.");
                }

                pendingKey = null;
            }
        }

        Findings = string.Join(Environment.NewLine, found.ToArray());
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="ScanAppSettingsForSecrets"
          BeforeTargets="Build"
          Condition="'$(SkipAppSettingsSecretScan)' != 'true'">

    <PropertyGroup>
      <!-- Defaults to the project being built; the repository wide scan in
           build/SecretHygiene.proj points it at the solution root instead. -->
      <AppSettingsScanRoot Condition="'$(AppSettingsScanRoot)' == ''">$(MSBuildProjectDirectory)</AppSettingsScanRoot>
    </PropertyGroup>

    <ItemGroup>
      <AppSettingsToScan Include="$(AppSettingsScanRoot)\**\appsettings*.json"
                         Exclude="$(AppSettingsScanRoot)\**\bin\**;$(AppSettingsScanRoot)\**\obj\**;$(AppSettingsScanRoot)\**\artifacts\**" />
    </ItemGroup>

    <ScanAppSettingsForSecrets Files="@(AppSettingsToScan)"
                               AllowedPathPrefixes="$(AppSettingsSecretScanAllowedPaths)"
                               Condition="'@(AppSettingsToScan)' != ''">
      <Output TaskParameter="Findings" PropertyName="AppSettingsSecretFindings" />
    </ScanAppSettingsForSecrets>

    <Error Condition="'$(AppSettingsSecretFindings)' != ''"
           Code="SEC0001"
           Text="Secret-shaped configuration key with a value found. Move the value into Key Vault and keep only the secret name in configuration.%0A$(AppSettingsSecretFindings)" />
  </Target>

</Project>
