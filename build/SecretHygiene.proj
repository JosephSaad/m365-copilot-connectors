<Project>

  <!--
    Repository wide secret hygiene scan, for the pre-commit hook and for CI.

        dotnet build build/SecretHygiene.proj -t:ScanAppSettingsForSecrets

    The same task runs automatically during a normal build of each project, over
    that project's own appsettings files. This entry point exists so the check
    can run without building any code.
  -->

  <PropertyGroup>
    <AppSettingsScanRoot>$(MSBuildThisFileDirectory)..</AppSettingsScanRoot>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)SecretHygiene.targets" />

  <!-- Nothing to compile; the imported target does the work. -->
  <Target Name="Build" DependsOnTargets="ScanAppSettingsForSecrets" />

</Project>
