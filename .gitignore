bin/
obj/
artifacts/
# A NuGet.config copied from build/NuGet.offline.config on an air-gapped build
# machine. It clears the package sources, so committing it would break every
# online build.
NuGet.config
NuGet.Config

# Staged nupkgs from build/Get-OfflinePackages.ps1: ~215 MB of downloads.
offline-packages/
*.nupkg
*.user
*.suo
.vs/
*.zip

# Certificate and key material must never be committed. The connector loads
# certificates from the Windows certificate store; there is no PFX loader.
*.pfx
*.p12
*.pem
*.key
*.cer
*.crt

# Local developer overrides of the shipped configuration.
appsettings.Development.json
appsettings.local.json

# Log output, when someone points Logging:Directory at the source tree.
Logs/
*.log

# Office lock files. Opening a committed .pptx or .xlsx drops one of these
# beside it, and it is binary noise that looks like a real document.
~$*
.DS_Store
